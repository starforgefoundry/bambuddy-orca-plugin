{
  "packages": {
    ".": {
      "release-type": "simple",
      "skip-changelog": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "plugin/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "plugin/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='bambuddy')].version"
        },
        "plugin/src/bambuddy/__init__.py"
      ]
    }
  }
}
